# ============================================================
# PymePlus IA — Plantilla de variables de entorno
# Copiar a .env y completar. NUNCA versionar el archivo .env
# ============================================================

# Servidor
NODE_ENV=development
HOST=0.0.0.0
PORT=3500

# Base de datos (requiere replica set para transacciones)
MONGO_URI=mongodb://127.0.0.1:27017/pymeplus_ia?replicaSet=rs0
MONGO_DB=pymeplus_ia

# Seguridad (mínimo 32 caracteres en producción)
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio-de-al-menos-32-caracteres
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=cambiar-por-otro-secreto-largo-y-aleatorio-de-al-menos-32-caracteres
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:4200
# Solo activar detrás de un proxy inverso de confianza; 1 = un salto.
TRUST_PROXY=false
# Revalidación del rol/estado del usuario contra MongoDB (milisegundos).
AUTH_REVALIDATE_TTL_MS=30000

# Limite de peticiones
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_SALES_MAX=60
RATE_LIMIT_SALES_WINDOW_MS=60000
RATE_LIMIT_REFRESH_MAX=30
RATE_LIMIT_REFRESH_WINDOW_MS=900000
RATE_LIMIT_FORGOT_PASSWORD_MAX=5
RATE_LIMIT_FORGOT_PASSWORD_WINDOW_MS=3600000
RATE_LIMIT_RESET_PASSWORD_MAX=10
RATE_LIMIT_RESET_PASSWORD_WINDOW_MS=3600000

# Carga de archivos / peticiones
BODY_LIMIT=10mb
MAX_FILE_SIZE_MB=10

# Tiempo real
SOCKET_IO_PATH=/socket.io

# Reglas de negocio
FALLBACK_BCV_RATE=36
RATE_MAX_AGE_HOURS=48
# Tasa de referencia de mercado (exchangerate-api, sin clave). NO es tasa BCV oficial (BR-25).
# Se guarda como fallback y se emite exchangeRate:updated cada 30 min.
MARKET_RATE_ENABLED=true
MARKET_RATE_URL=https://open.er-api.com/v6/latest/USD
MARKET_RATE_INTERVAL_MINUTES=30
MARKET_RATE_TIMEOUT_MS=8000
MARKET_RATE_MAX_AGE_HOURS=48
VOID_WINDOW_HOURS=24

# Datos iniciales del seeder (SOLO development; el seeder se niega en producción)
SEED_ADMIN_EMAIL=admin@pymeplus.local
SEED_ADMIN_PASSWORD=Admin12345
# Usuarios demo por rol. Define passwords propias de al menos 8 caracteres.
# NUNCA imprimas estos valores en logs ni los versiones.
SEED_CASHIER_EMAIL=cashier@pymeplus.local
SEED_CASHIER_PASSWORD=cambiar-password-cajero
SEED_SUPERVISOR_EMAIL=supervisor@pymeplus.local
SEED_SUPERVISOR_PASSWORD=cambiar-password-supervisor
SEED_WAREHOUSE_EMAIL=warehouse@pymeplus.local
SEED_WAREHOUSE_PASSWORD=cambiar-password-almacen
SEED_FINANCE_EMAIL=finance@pymeplus.local
SEED_FINANCE_PASSWORD=cambiar-password-finanzas

# Identidad del negocio (usado en facturas y reportes)
APP_NAME=PymePlus IA
TIMEZONE=America/Caracas
BASE_CURRENCY=USD
DISPLAY_CURRENCY=VES

# Correo de facturas (si no se define, queda en microservices/outbox/)
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_TOKEN=
PASSWORD_RESET_URL=http://localhost:4200/reset-password

# Conectores MCP (fase posterior)
TELEGRAM_BOT_TOKEN=
